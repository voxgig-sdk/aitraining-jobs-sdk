      n: "first_seen_at"
      r: true
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      t: "`$STRING`"
    }
    kind: {
      h: "Kind"
      n: "kind"
      r: false
      sh: "Kind of work"
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    kind_slug: {
      h: "Kind Slug"
      n: "kind_slug"
      r: false
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    listed: {
      fo: "date"
      h: "Listed"
      n: "listed"
      r: true
      t: "`$STRING`"
    }
    location: {
      h: "Location"
      n: "location"
      r: false
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    pay: {
      h: "Pay"
      n: "pay"
      r: false
      sh: "The role's advertised pay, else its platform's typical band (said so in the text)"
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    platform: {
      h: "Platform"
      n: "platform"
      r: true
      sh: "Platform name"
      t: "`$STRING`"
    }
    platform_slug: {
      h: "Platform Slug"
      n: "platform_slug"
      r: true
      t: "`$STRING`"
    }
    remote: {
      h: "Remote"
      n: "remote"
      r: true
      t: "`$BOOLEAN`"
    }
    title: {
      h: "Title"
      n: "title"
      r: true
      t: "`$STRING`"
    }
    url: {
      fo: "uri"
      h: "Url"
      n: "url"
      r: true
      sh: "The role's page on AITraining.jobs, where the user applies"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "job"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /api/v1/jobs"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "country"
                or: "country"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "kind"
                or: "kind"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 20
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "min_hourly_usd"
                or: "min_hourly_usd"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 0
                k: "query"
                n: "offset"
                or: "offset"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "platform"
                or: "platform"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "q"
                or: "q"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "since"
                or: "since"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "recent"
